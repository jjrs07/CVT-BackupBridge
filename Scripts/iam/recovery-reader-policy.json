{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDesignatedRecoveryPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        },
        "StringLike": {
          "s3:prefix": [
            "<PREFIX>",
            "<PREFIX>/*"
          ]
        }
      }
    },
    {
      "Sid": "DownloadBackupObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/<PREFIX>/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    }
  ]
}
